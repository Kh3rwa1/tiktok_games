# =====================================================
# TikTok Games Server - Production Configuration
# =====================================================
# Copy this file to .env and update values for your setup

# =====================================================
# SERVER CONFIGURATION
# =====================================================
NODE_ENV=production
PORT=5000

# Domain configuration (for production)
# Example: https://yourdomain.com or https://api.yourdomain.com
DOMAIN=http://localhost:5000
ADMIN_PANEL_URL=http://localhost:5000

# =====================================================
# MySQL DATABASE
# =====================================================
# For cPanel: MySQL Databases > Create Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_username_dbuser
DB_PASSWORD=your_database_password
DB_NAME=your_cpanel_username_tiktok_games
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# =====================================================
# SECURITY - JWT
# =====================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# =====================================================
# SECURITY - SESSIONS & COOKIES
# =====================================================
SESSION_SECRET=your-session-secret-change-this-in-production
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict

# =====================================================
# SECURITY - RATE LIMITING
# =====================================================
# General API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Auth endpoints rate limit
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50

# =====================================================
# SECURITY - CORS
# =====================================================
# Comma-separated list of allowed origins
# Use * to allow all (not recommended for production)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =====================================================
# SECURITY - ADMIN PANEL
# =====================================================
# Initial admin credentials (used only for first setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=changeme123!

# =====================================================
# FILE UPLOADS
# =====================================================
# Maximum file sizes (in bytes)
MAX_FILE_SIZE=104857600
MAX_GAME_ZIP_SIZE=104857600
MAX_THUMBNAIL_SIZE=5242880
MAX_AVATAR_SIZE=2097152

# Allowed file types
ALLOWED_GAME_TYPES=.zip
ALLOWED_IMAGE_TYPES=.jpg,.jpeg,.png,.gif,.webp

# Upload directories
UPLOAD_DIR=./public/uploads
GAMES_DIR=./public/games
THUMBNAILS_DIR=./public/thumbnails

# =====================================================
# ONESIGNAL PUSH NOTIFICATIONS
# =====================================================
# Get these from https://onesignal.com > Your App > Settings > Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_ENABLED=false

# =====================================================
# EMAIL CONFIGURATION (Optional)
# =====================================================
# For password reset, notifications, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=TikTok Games

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=info
LOG_FILE=./logs/server.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =====================================================
# ANALYTICS (Optional)
# =====================================================
ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=

# =====================================================
# MAINTENANCE MODE
# =====================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance. Please try again later.

# =====================================================
# APP SETTINGS
# =====================================================
APP_NAME=TikTok Games
APP_VERSION=4.0.0
APP_DESCRIPTION=Play amazing HTML5 games
SUPPORT_EMAIL=support@yourdomain.com
PRIVACY_POLICY_URL=https://yourdomain.com/privacy
TERMS_OF_SERVICE_URL=https://yourdomain.com/terms

# =====================================================
# FEATURES
# =====================================================
REGISTRATION_ENABLED=true
SOCIAL_LOGIN_ENABLED=false
GUEST_PLAY_ENABLED=true
COMMENTS_ENABLED=true
RATINGS_ENABLED=true

# =====================================================
# CACHING (Optional - Redis)
# =====================================================
CACHE_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================================================
# CDN (Optional)
# =====================================================
CDN_ENABLED=false
CDN_URL=https://cdn.yourdomain.com

# =====================================================
# BACKUP (Optional)
# =====================================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
