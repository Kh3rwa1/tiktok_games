# ===========================================
# TikTok Games Server + Admin Panel
# Unified Deployment Configuration
# ===========================================

# Server Configuration
NODE_ENV=production
PORT=5000

# ===========================================
# Firebase Configuration
# ===========================================
# Get these from your Firebase Project Settings > Service Accounts
# Option 1: Provide service account JSON as environment variable (recommended for production)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Option 2: Path to service account JSON file (recommended for development)
# Place your firebase-service-account.json file in this directory

FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ===========================================
# CORS Configuration
# ===========================================
# Development
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===========================================
# Redis Configuration (Optional - for caching)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# AWS Notification Services
# ===========================================
# Required for AWS notifications (SNS/SES)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# AWS SNS - Push Notifications
# Create a topic in AWS SNS console and paste ARN here
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:tiktok-games-notifications

# AWS SES - Email Service
# Must verify email/domain in AWS SES before use
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_REGION=us-east-1

# AWS S3 - File Storage (Optional - if not using Firebase Storage)
AWS_S3_BUCKET=tiktok-games-assets

# ===========================================
# Security
# ===========================================
# JWT Secret for API authentication
# Generate a strong random string: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# Database (if using MongoDB instead of Firestore)
# ===========================================
# MONGODB_URI=mongodb://username:password@localhost:27017/tiktok_games
