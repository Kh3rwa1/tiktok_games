# ===========================================
# TikTok Games Server - cPanel Configuration
# ===========================================

# Server
NODE_ENV=production
PORT=5000

# ===========================================
# MySQL Database (phpMyAdmin)
# ===========================================
# Get these from cPanel > MySQL Databases
DB_HOST=localhost
DB_USER=your_cpanel_username_dbuser
DB_PASSWORD=your_database_password
DB_NAME=your_cpanel_username_tiktok_games

# ===========================================
# JWT Secret
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# ===========================================
# CORS (Optional)
# ===========================================
# Comma-separated list of allowed origins
# Leave empty or use * to allow all
ALLOWED_ORIGINS=*

# ===========================================
# OneSignal Push Notifications (Optional)
# ===========================================
# Get these from https://onesignal.com
# You can also configure these in Admin Panel > Settings
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
