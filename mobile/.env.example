# ==============================================
# TikTok Games Mobile App - SINGLE URL CONFIG
# ==============================================
#
# Copy this file to .env and update with your server URL.
# That's ALL you need to configure!

# Server API URL (REQUIRED)
# This is the ONLY setting you need!
EXPO_PUBLIC_API_URL=https://your-server-domain.com

# ==============================================
# THAT'S IT - NO MORE CONFIGURATION NEEDED!
# ==============================================
#
# The app automatically connects to:
# - /api/auth/*   - Authentication (login, register, profile)
# - /api/games/*  - Game data (list, play, like, rate)
# - /api/social/* - Social features (comments, follows, feed)
# - /health       - Server health check
#
# Benefits of Single URL:
# - Easy deployment - one URL to configure
# - No Firebase setup required
# - Works with any server that implements the API
# - Consistent data across all features
#
# Example values:
# - Local development: http://localhost:5000
# - Local network: http://192.168.1.100:5000
# - Production: https://api.yourgames.com
