{
  "name": "tiktok-games-server-admin",
  "version": "3.0.0",
  "description": "Unified Server + Admin Panel for TikTok Games - Easy cPanel/VPS deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "eslint . --ext .js",
    "build:admin": "cd ../admin-panel && npm run build && cp -r dist/* ../server-admin-panel/public/",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "postinstall": "echo 'Run npm run build:admin to build the admin panel'"
  },
  "keywords": ["games", "streaming", "api", "scalable", "redis", "firebase", "admin-panel", "notifications"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.470.0",
    "@aws-sdk/client-sns": "^3.470.0",
    "@google-cloud/storage": "^7.7.0",
    "aws-sdk": "^2.1517.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
